# ==========================================
# passwordeeri — Environment Configuration
# ==========================================
# Copy this file to config.env and fill in your values.
#   cp .env.example config.env
#
# MASTER_KEY must be 64 hex characters (32 bytes).
# Generate one with: openssl rand -hex 32
# ==========================================

# --- Server ---
# Shown in the browser title + login heading + topbar. Brand it however you like.
APP_NAME=passwordeeri

PORT=3000

# Session secret — at least 16 characters, any random string
SESSION_SECRET=change-me-to-a-random-string

# Encryption key — exactly 64 hex characters (32 bytes)
# Generate: openssl rand -hex 32
MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Set to true when serving behind HTTPS (adds Secure flag to session cookie)
# COOKIE_SECURE=false

# Session lifetime in hours (default: 8)
SESSION_TTL_HOURS=8

# How often (minutes) to re-verify LDAP group membership during a session (default: 15)
SESSION_REFRESH_MINUTES=15

# --- LDAP ---
# LDAP server (use ldaps:// for TLS)
LDAP_URL=ldap://ldap.example.com:389

# Service account DN used for initial LDAP bind
LDAP_BIND_DN=cn=passwordeeri,ou=service-accounts,dc=example,dc=com

# Service account password
LDAP_BIND_PASSWORD=change-me

# Base DN for LDAP searches
LDAP_SEARCH_BASE=dc=example,dc=com

# LDAP filter to find a user by their login name.
# {{username}} is replaced with the submitted login value.
LDAP_USER_FILTER=(&(objectClass=user)(sAMAccountName={{username}}))

# LDAP filter to find groups when memberOf attribute is missing.
# {{user_dn}} is replaced with the user's full DN.
# Leave empty if memberOf is sufficient.
LDAP_GROUP_FILTER=(&(objectClass=group)(member={{user_dn}}))

# LDAP attribute holding group membership (default: memberOf)
LDAP_GROUP_ATTR=memberOf

# --- Storage ---
# Directory for SQLite database (relative to /app in container)
DATA_DIR=./data